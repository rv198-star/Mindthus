        "activation": {
          "event": "before-answer",
          "source_ref": "validation:entry-triage",
          "reason": "候选答案可能用更高抽象替换有效局部范围",
          "frame_risk": true,
          "execution_impact": true,
          "required": false,
          "checks": ["explanatory_scope", "premise_treatment", "scope_preservation"]
        }
      }
    },
