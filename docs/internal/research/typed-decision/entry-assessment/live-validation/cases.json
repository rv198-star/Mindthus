    {
      "id": "N02_explicit_local_scope",
      "family": "negative_explicit_scope",
      "expected_hit": null,
      "correction_criteria": [],
      "input": {
        "state_version": "1",
        "task": {
          "request": "只解释正则 ^foo$ 为什么匹配不了字符串 'foo '，不要扩展到业务设计。",
          "constraints": ["只解释这个匹配失败。"],
          "evidence": [
            {
              "source_ref": "validation:N02-input",
              "summary": "实际输入是三个字母 foo 后跟一个空格；模式要求 foo 后立即到字符串末尾。"
            }
          ],
          "provenance": {"source_ref": "validation:N02-task", "revision": "1"},
          "known_obligations": [],
          "explicit_method": null,
          "risk": "low",
          "freshness": "current",
          "permission": {"mode": "advisory", "source_ref": "validation:owner"}
        },
        "decision_context": {
          "object": "这个正则匹配失败",
          "goal": "说明直接原因",
          "scope": "不扩展业务设计",
          "source_ref": "validation:N02-context"
        },
        "target": {
          "id": "candidate-answer",
          "kind": "candidate_answer",
          "version": "1",
          "source_ref": "validation:N02-candidate",
          "text": "因为输入在 foo 后还有一个空格，而 ^foo$ 要求 foo 之后就是字符串结尾，所以不会匹配。"
        },
        "activation": {
          "event": "before-answer",
          "source_ref": "validation:negative-control",
          "reason": "反向控制：明确局部问题不应被强行升维",
          "frame_risk": true,
          "execution_impact": true,
          "required": false,
          "checks": ["explanatory_scope", "premise_treatment", "scope_preservation"]
        }
      }
    },
