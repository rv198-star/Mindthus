            }
          ],
          "provenance": {"source_ref": "validation:V01-task", "revision": "1"},
          "known_obligations": [],
          "explicit_method": null,
          "risk": "low",
          "freshness": "current",
          "permission": {"mode": "advisory", "source_ref": "validation:owner"}
        },
        "decision_context": {
          "object": "这个发布是否具备上线条件",
          "goal": "在现有证据上判断上线准备度",
          "scope": "只评价现有发布证据，不执行发布",
          "source_ref": "validation:V01-context"
