          "scope": "只给排查建议，不直接修改数据库",
          "source_ref": "validation:V02-context"
        },
        "target": {
          "id": "candidate-plan",
          "kind": "candidate_plan",
          "version": "1",
          "source_ref": "validation:V02-candidate",
