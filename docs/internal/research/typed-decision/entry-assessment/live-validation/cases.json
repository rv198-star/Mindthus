      "input": {
        "state_version": "1",
        "task": {
          "request": "只比较 json 和 orjson 在这个 Python API 的序列化 CPU 开销，先不要讨论架构迁移。",
          "constraints": ["范围限定为序列化实现比较。"],
          "evidence": [
            {
              "source_ref": "validation:V03-benchmark",
              "summary": "同一固定 payload 的基准中，json 平均 CPU 时间 18 ms，orjson 7 ms；未提供架构迁移收益数据。"
            }
          ],
          "provenance": {"source_ref": "validation:V03-task", "revision": "1"},
          "known_obligations": [],
          "explicit_method": null,
          "risk": "low",
          "freshness": "current",
          "permission": {"mode": "advisory", "source_ref": "validation:owner"}
        },
        "decision_context": {
          "object": "两个 Python JSON 序列化实现的 CPU 开销",
          "goal": "在固定基准下比较局部实现",
          "scope": "不讨论架构迁移",
          "source_ref": "validation:V03-context"
        },
        "target": {
          "id": "candidate-answer",
          "kind": "candidate_answer",
          "version": "1",
          "source_ref": "validation:V03-candidate",
          "text": "更重要的是应该把整个服务改成事件驱动架构，这比纠结 json 和 orjson 更有意义。"
