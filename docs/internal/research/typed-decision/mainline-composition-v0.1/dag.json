  "edges": [
    {
      "from": "input",
      "to": "identity",
      "condition": "always"
    },
    {
      "from": "identity",
      "to": "existing",
      "condition": "valid"
    },
    {
      "from": "identity",
      "to": "partial",
      "condition": "invalid_or_unknown_intent"
    },
    {
      "from": "identity",
      "to": "direct",
      "condition": "known_clear_deterministic_task"
    },
    {
      "from": "existing",
      "to": "view",
      "condition": "existing_or_bounded_proposal"
    },
    {
      "from": "view",
      "to": "direct",
      "condition": "direct_or_verified_reuse"
    },
    {
      "from": "view",
      "to": "partial",
      "condition": "missing_or_unresolved_issue"
    },
    {
      "from": "view",
      "to": "screen",
      "condition": "judgment_candidates_needed"
    },
    {
      "from": "view",
      "to": "evaluate",
      "condition": "full_contracts_already_available"
    },
    {
      "from": "screen",
      "to": "load",
      "condition": "retained_within_capacity"
    },
    {
      "from": "screen",
      "to": "partial",
      "condition": "overflow_or_no_match"
    },
    {
      "from": "load",
      "to": "evaluate",
      "condition": "contracts_bound"
    },
    {
      "from": "evaluate",
      "to": "plan",
      "condition": "consistent_and_all_required_contracts_available"
    },
    {
      "from": "evaluate",
      "to": "partial",
      "condition": "unresolved_component"
    },
    {
      "from": "plan",
      "to": "audit",
      "condition": "actual_proposal_available"
    },
    {
      "from": "audit",
      "to": "execute",
      "condition": "no_blocking_finding"
    },
    {
      "from": "audit",
      "to": "revision",
      "condition": "named_fix_and_budget"
    },
    {
      "from": "revision",
      "to": "recheck",
      "condition": "new_proposal_version"
    },
    {
      "from": "recheck",
      "to": "execute",
      "condition": "fixed"
    },
    {
      "from": "recheck",
      "to": "partial",
      "condition": "still_unresolved"
    },
    {
      "from": "execute",
      "to": "artifacts",
      "condition": "outputs_observed"
    },
    {
      "from": "artifacts",
      "to": "handoff",
      "condition": "required_use_satisfied"
    },
    {
      "from": "artifacts",
      "to": "partial",
      "condition": "missing_stale_conflicting"
    },
    {
      "from": "handoff",
      "to": "answercheck",
      "condition": "candidate_now_exists_and_triggered"
    },
    {
      "from": "handoff",
      "to": "answer",
      "condition": "no_additional_check_needed"
    },
    {
      "from": "answercheck",
      "to": "answer",
      "condition": "bounded_check_complete"
    },
    {
      "from": "answercheck",
      "to": "partial",
      "condition": "still_unresolved"
    },
    {
      "from": "direct",
      "to": "answer",
      "condition": "bounded_original_task"
    },
    {
      "from": "partial",
      "to": "answer",
      "condition": "only_supported_partial_delivery_or_named_gap"
    },
    {
      "from": "evaluate",
      "to": "companion_load",
      "condition": "M05_triggered_and_required_contract_absent"
    },
    {
      "from": "companion_load",
      "to": "companion_evaluate",
      "condition": "new_contract_loaded_within_shared_budget"
    },
    {
      "from": "companion_evaluate",
      "to": "plan",
      "condition": "relations_established"
    },
    {
      "from": "companion_evaluate",
      "to": "partial",
      "condition": "budget_or_unresolved"
    }
  ],
  "packing_rule": "Input/contract/new-artifact availability determines API batches; Noul/Choice/Score are not serial stages. Same-State V checks may pack when plan already exists.",
  "runtime_unroll": "Finite method steps reference versioned artifacts; multi-turn changes create new nodes and spend same episode budget. No backward edges to an already executed version.",
  "budget_ref": "policy.json",
  "subgraph_ref": "../entry-assessment/original-scenarios-design/D3-repair-r3/disposition.md",
  "execution_expansion": {
    "per_step": [
      "begin",
      "produce",
      "accepted_output",
      "commit"
    ],
    "needed_to_begin": "producer.accepted_output -> consumer.begin",
    "needed_before_commit": "producer.accepted_output -> consumer.commit; independent preparation may begin earlier",
    "conditional": "guarded forward edge, requires named condition evidence",
    "versioned_node_ids": true,
    "reuse_node": "verified existing output supplies accepted_output without rerunning producer",
    "cycle_action": "stop affected component and at most one host arbitration, not random edge deletion",
    "parallelism": "absence of semantic dependency is not permission to execute concurrently; resource/authority locks still apply"
  }
}
